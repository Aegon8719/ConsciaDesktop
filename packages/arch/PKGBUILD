# Build from the ConsciaDesktop checkout; source trees live only in makepkg's BUILDDIR.
pkgname=ConsciaDesktop
_project=$(cd -- "$startdir/../.." && pwd)
pkgver=$(python -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$_project/versions.lock")
pkgrel=1
pkgdesc='Conscia niri compositor and DMS shell with pinned compatible fork revisions'
arch=('x86_64')
url='https://github.com/Aegon8719/ConsciaDesktop'
license=('GPL-3.0-or-later' 'MIT')
provides=(niri dms-shell wayland-compositor)
conflicts=(niri dms-shell conscia-desktop)
depends=(quickshell matugen python gdk-pixbuf2 librsvg
         cairo glib2 glibc libdisplay-info libgcc libinput libpipewire libxkbcommon
         mesa pango pixman seatd systemd-libs
         xwayland-satellite xdg-desktop-portal-gnome xdg-desktop-portal-gtk
         gnome-keyring accountsservice polkit networkmanager pipewire pipewire-pulse wireplumber
         alacritty brightnessctl playerctl wl-clipboard wtype cava
         qt6-multimedia qt6ct breeze-cursors adwaita-icon-theme noto-fonts noto-fonts-emoji)
makedepends=(git rust go clang pkgconf libinput libxkbcommon libdisplay-info seatd
             libpipewire pango cairo mesa wayland)
# Rust keeps its own ThinLTO; GCC LTO objects cannot be linked by Rust's lld.
options=('!debug' '!strip' '!lto')

build() {
    python "$_project/scripts/build.py" --work "$srcdir/forks" --output "$srcdir/payload"
}

package() {
    cp -a "$srcdir/payload/." "$pkgdir/"
}
